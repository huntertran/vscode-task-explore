{
  "name": "hunter-task-explorer",
  "displayName": "Hunter's Task Explorer",
  "description": "Explore and run tasks from .vscode/tasks.json and other detected sources in a sidebar.",
  "version": "0.5.0",
  "publisher": "huntertran",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasks",
    "task runner",
    "tasks.json",
    "explorer",
    "sidebar",
    "favorites",
    "npm scripts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huntertran/vscode-task-explore.git"
  },
  "homepage": "https://github.com/huntertran/vscode-task-explore#readme",
  "bugs": {
    "url": "https://github.com/huntertran/vscode-task-explore/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskExplorer",
          "title": "Task Explorer",
          "icon": "media/task-explorer.svg"
        }
      ]
    },
    "views": {
      "taskExplorer": [
        {
          "id": "taskExplorer.tasksView",
          "name": "Tasks",
          "when": "config.taskExplorer.viewStyle != 'webview'"
        },
        {
          "id": "taskExplorer.tasksWebview",
          "name": "Tasks",
          "type": "webview",
          "when": "config.taskExplorer.viewStyle == 'webview'"
        }
      ]
    },
    "configuration": {
      "title": "Task Explorer",
      "properties": {
        "taskExplorer.viewStyle": {
          "type": "string",
          "enum": [
            "tree",
            "webview"
          ],
          "enumDescriptions": [
            "Native VSCode tree view. Lightweight, single-line items.",
            "Richer webview: two-line items (title + detail), right-aligned elapsed runtime, and colored run/stop buttons. Heavier."
          ],
          "default": "tree",
          "scope": "application",
          "description": "How the task list is rendered. Switch takes effect immediately. Global."
        },
        "taskExplorer.showWorkspaceScripts": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Scan the workspace for script files (.ps1, .sh, .bat, .cmd, .py, …) and list them under a 'Workspace Scripts' category, grouped by script type."
        },
        "taskExplorer.scriptScanDelay": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "resource",
          "description": "Milliseconds to wait after the extension activates before scanning the workspace for script files. Set to a non-zero value for large workspaces where the scan noticeably slows down startup. 0 = scan immediately."
        },
        "taskExplorer.openDefinitionOnClick": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "When enabled, clicking a task opens the file that defines it (tasks.json / package.json) instead of showing its output."
        },
        "taskExplorer.hiddenCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Task source categories hidden from the sidebar in this workspace. Manage via Task Explorer settings."
        },
        "taskExplorer.hiddenTasks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Individual tasks hidden from the sidebar in this workspace (by internal id). Manage via Task Explorer settings."
        },
        "taskExplorer.favorites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Favorited tasks shown in the Favorites section (by internal id). Manage via right-click or Task Explorer settings."
        }
      }
    },
    "commands": [
      {
        "command": "taskExplorer.refresh",
        "title": "Refresh Tasks",
        "category": "Task Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "taskExplorer.runTask",
        "title": "Run Task",
        "category": "Task Explorer",
        "icon": "$(play)"
      },
      {
        "command": "taskExplorer.stopTask",
        "title": "Stop Task",
        "category": "Task Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskExplorer.showOutput",
        "title": "Show Output",
        "category": "Task Explorer",
        "icon": "$(output)"
      },
      {
        "command": "taskExplorer.runScript",
        "title": "Run Script",
        "category": "Task Explorer",
        "icon": "$(play)"
      },
      {
        "command": "taskExplorer.stopScript",
        "title": "Stop Script",
        "category": "Task Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskExplorer.openSettings",
        "title": "Open Settings",
        "category": "Task Explorer",
        "icon": "$(gear)"
      },
      {
        "command": "taskExplorer.addFavorite",
        "title": "Add to Favorites",
        "category": "Task Explorer",
        "icon": "$(star-empty)"
      },
      {
        "command": "taskExplorer.removeFavorite",
        "title": "Remove from Favorites",
        "category": "Task Explorer",
        "icon": "$(star-full)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskExplorer.refresh",
          "when": "view == taskExplorer.tasksView || view == taskExplorer.tasksWebview",
          "group": "navigation@1"
        },
        {
          "command": "taskExplorer.openSettings",
          "when": "view == taskExplorer.tasksView || view == taskExplorer.tasksWebview",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "taskExplorer.runTask",
          "when": "view == taskExplorer.tasksView && viewItem =~ /^task(Fav)?$/",
          "group": "inline@1"
        },
        {
          "command": "taskExplorer.showOutput",
          "when": "view == taskExplorer.tasksView && viewItem =~ /^taskRunning(Fav)?$/",
          "group": "inline@1"
        },
        {
          "command": "taskExplorer.stopTask",
          "when": "view == taskExplorer.tasksView && viewItem =~ /^taskRunning(Fav)?$/",
          "group": "inline@2"
        },
        {
          "command": "taskExplorer.addFavorite",
          "when": "view == taskExplorer.tasksView && viewItem =~ /^task(Running)?$/",
          "group": "1_fav@1"
        },
        {
          "command": "taskExplorer.removeFavorite",
          "when": "view == taskExplorer.tasksView && viewItem =~ /^task(Running)?Fav$/",
          "group": "1_fav@1"
        },
        {
          "command": "taskExplorer.runScript",
          "when": "view == taskExplorer.tasksView && viewItem == scriptFile",
          "group": "inline@1"
        },
        {
          "command": "taskExplorer.stopScript",
          "when": "view == taskExplorer.tasksView && viewItem == scriptFileRunning",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run build:css && tsc -p ./",
    "build:css": "sass media/webview.scss:media/webview.css media/settings.scss:media/settings.css --no-source-map --style=expanded",
    "watch:css": "sass --watch media/webview.scss:media/webview.css media/settings.scss:media/settings.css --no-source-map",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^10.4.0",
    "sass": "^1.100.0",
    "typescript": "^5.4.0"
  }
}
